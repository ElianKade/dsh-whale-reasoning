{
  "name": "dsh-whale-reasoning",
  "version": "1.1.0",
  "type": "module",
  "main": "./index.js",
  "description": "Whale Reasoning: a two-step model and reasoning selector with an animated blue four-level track for the DeepSeek Harness composer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElianKade/dsh-whale-reasoning.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
